{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET list — no token",
      "method": "GET",
      "path": "/",
      "queryStringParameters": {"action": "list"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST send — no token",
      "method": "POST",
      "path": "/",
      "body": {"action": "send", "chat_id": 1, "text": "hi"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    }
  ]
}
